# EditorConfig — https://editorconfig.org
# Keep this file close to the conventions used by the DSH repositories.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Trailing spaces are meaningful in Markdown (hard line breaks, tables).
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.js]
indent_size = 2

[LICENSE]
# License texts are reproduced verbatim; do not reshape paragraphs.
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf
